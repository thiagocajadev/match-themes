{
  "name": "match-themes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OKLCH-first palette studio that exports directly to Tailwind v4 / shadcn",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
